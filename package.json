{
  "name": "enki-website",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite dev --port 5000",
    "build": "vite build",
    "package": "svelte-kit package",
    "preview": "vite preview --port 4000",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run",
    "test:integration": "kill $(lsof -i:8080) || true && npm run mock-server && playwright test && kill $(lsof -i:8080)",
    "test:integration:update-snapshots": "kill $(lsof -i:8080) || true && npm run mock-server && playwright test --update-snapshots && kill $(lsof -i:8080)",
    "test:integration:ci": "npm run mock-server && npx playwright test",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "npm run format && eslint --fix",
    "format": "prettier --write .",
    "prepare": "svelte-kit sync",
    "mock-server": "mockserver -p 8080 -m tests/mocks &",
    "unlighthouse": "CHROME_PATH=/usr/bin/chromium-bin npx unlighthouse --site enkionline.com --no-cache"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/load-config": "^0.2.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.168",
    "@types/node": "^26",
    "@vitest/browser": "^5.0.5",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.12.4",
    "globals": "^16.4.0",
    "husky": "^7.0.0",
    "jest-canvas-mock": "^2.5.1",
    "jsdom": "^29.1.1",
    "mockserver": "^3.1.1",
    "node-fetch": "^3.3.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.7",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.8.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.44.1",
    "vite": "^8.0.12",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0"
  },
  "dependencies": {
    "@stripe/stripe-js": "^1.54.1",
    "canvas-confetti": "^1.6.0",
    "fp-ts": "^2.16.0",
    "lodash-es": "^4.17.21",
    "lodash.groupby": "^4.6.0",
    "swiper": "^8.4.4"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
